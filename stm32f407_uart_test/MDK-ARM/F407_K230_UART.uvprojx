<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">
  <SchemaVersion>2.1</SchemaVersion>
  <Header>### uVision Project, (C) Keil Software</Header>
  <Targets>
    <Target>
      <TargetName>F407_K230_UART</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <pCCUsed>6240000::V6.24::ARMCLANG</pCCUsed>
      <uAC6>1</uAC6>
      <TargetOption>
        <TargetCommonOption>
          <Device>STM32F407VE</Device>
          <Vendor>STMicroelectronics</Vendor>
          <Cpu>IRAM(0x20000000,0x20000) IROM(0x08000000,0x80000) CPUTYPE("Cortex-M4") FPU2 CLOCK(16000000) ELITTLE</Cpu>
          <StartupFile></StartupFile>
          <OutputDirectory>.\Objects\</OutputDirectory>
          <OutputName>F407_K230_UART</OutputName>
          <CreateExecutable>1</CreateExecutable>
          <CreateLib>0</CreateLib>
          <CreateHexFile>1</CreateHexFile>
          <DebugInformation>1</DebugInformation>
          <BrowseInformation>0</BrowseInformation>
          <ListingPath>.\Listings\</ListingPath>
          <HexFormatSelection>1</HexFormatSelection>
        </TargetCommonOption>
        <CommonProperty>
          <IncludeInBuild>1</IncludeInBuild>
          <StopOnExitCode>3</StopOnExitCode>
        </CommonProperty>
        <DllOption>
          <SimDllName>SARMCM3.DLL</SimDllName>
          <SimDllArguments>-REMAP</SimDllArguments>
          <TargetDllName>SARMCM3.DLL</TargetDllName>
          <TargetDllArguments>-REMAP</TargetDllArguments>
        </DllOption>
        <DebugOption>
          <OPTHX><HexSelection>1</HexSelection></OPTHX>
          <Simulator><UseSimulator>0</UseSimulator></Simulator>
          <Target><UseTarget>1</UseTarget><DriverSelection>6</DriverSelection></Target>
        </DebugOption>
        <TargetArmAds>
          <ArmAdsMisc>
            <AdsLmap>1</AdsLmap>
            <AdsLcgr>1</AdsLcgr>
            <AdsLsym>1</AdsLsym>
            <AdsLszi>1</AdsLszi>
            <AdsLtoi>1</AdsLtoi>
            <AdsLsun>1</AdsLsun>
            <AdsLven>1</AdsLven>
            <RvdsVP>2</RvdsVP>
            <hadIROM>1</hadIROM>
            <hadIRAM>1</hadIRAM>
            <useUlib>1</useUlib>
            <OnChipMemories>
              <IRAM><Type>0</Type><StartAddress>0x20000000</StartAddress><Size>0x20000</Size></IRAM>
              <IROM><Type>1</Type><StartAddress>0x08000000</StartAddress><Size>0x80000</Size></IROM>
              <OCR_RVCT4><Type>1</Type><StartAddress>0x08000000</StartAddress><Size>0x80000</Size></OCR_RVCT4>
              <OCR_RVCT9><Type>0</Type><StartAddress>0x20000000</StartAddress><Size>0x20000</Size></OCR_RVCT9>
            </OnChipMemories>
          </ArmAdsMisc>
          <Cads>
            <Optim>3</Optim>
            <wLevel>2</wLevel>
            <uC99>1</uC99>
            <v6Lang>1</v6Lang>
            <v6LangP>1</v6LangP>
            <vShortEn>1</vShortEn>
            <vShortWch>1</vShortWch>
            <VariousControls>
              <MiscControls>-std=c11 -Wall -Wextra</MiscControls>
              <Define>STM32F407xx</Define>
              <Undefine></Undefine>
              <IncludePath>..\Core\Inc;..\Drivers\CMSIS\Core\Include;..\Drivers\CMSIS\Device\ST\STM32F4xx\Include</IncludePath>
            </VariousControls>
          </Cads>
          <Aads>
            <thumb>1</thumb>
            <uClangAs>0</uClangAs>
            <VariousControls>
              <MiscControls></MiscControls>
              <Define>__MICROLIB</Define>
              <Undefine></Undefine>
              <IncludePath></IncludePath>
            </VariousControls>
          </Aads>
          <LDads>
            <umfTarg>0</umfTarg>
            <useFile>1</useFile>
            <ScatterFile>.\stm32f407ve.sct</ScatterFile>
            <Misc>--strict</Misc>
          </LDads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File><FileName>main.c</FileName><FileType>1</FileType><FilePath>..\Core\Src\main.c</FilePath></File>
            <File><FileName>board.c</FileName><FileType>1</FileType><FilePath>..\Core\Src\board.c</FilePath></File>
            <File><FileName>link_test.c</FileName><FileType>1</FileType><FilePath>..\Core\Src\link_test.c</FilePath></File>
          </Files>
        </Group>
        <Group>
          <GroupName>Startup</GroupName>
          <Files>
            <File><FileName>startup_stm32f407xx.s</FileName><FileType>2</FileType><FilePath>..\Startup\startup_stm32f407xx.s</FilePath></File>
          </Files>
        </Group>
        <Group>
          <GroupName>Headers</GroupName>
          <Files>
            <File><FileName>board.h</FileName><FileType>5</FileType><FilePath>..\Core\Inc\board.h</FilePath></File>
            <File><FileName>link_test.h</FileName><FileType>5</FileType><FilePath>..\Core\Inc\link_test.h</FilePath></File>
          </Files>
        </Group>
      </Groups>
    </Target>
  </Targets>
</Project>
